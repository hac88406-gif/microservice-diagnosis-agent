# ============================================================
# 微服务智能诊断 Agent · Git 忽略规则
# 纪律：密钥 / 构建产物 / 运行时产物永不入库
# ============================================================

# ---- 密钥与本地环境变量（永不入库；.env.example 作为模板入库）----
.env
.env.*
!.env.example

# ---- Java / Maven 构建产物 ----
target/
*.class

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# ---- Node（演示前端）----
node_modules/
dist/

# ---- 运行时产物 / 日志 ----
logs/
*.log
*.pid

# ---- IDE / 操作系统 ----
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db